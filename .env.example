HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://localhost:5173
DATA_DIR=./data
# Production: set NODE_ENV=production, PUBLIC_URL=https://your-domain,
# and a permanent 32-byte hex encryption key (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Keep the key with your backup: it decrypts storage credentials.
ENCRYPTION_KEY=
# Optional external quota provisioning API. Disabled when empty.
QUOTA_INTEGRATION_TOKEN=
# Only trust proxy headers when the API is reachable exclusively through your proxy.
# The Compose deployment sets this to 1 and publishes the API on loopback only.
TRUST_PROXY=0
# Compose / install.sh options; unused by the local development server.
YINGYU_PORT=8787
YINGYU_DOMAIN=images.example.com
# Set to https for the bundled Caddy proxy, or leave empty for an existing proxy.
COMPOSE_PROFILES=
COMPOSE_PROJECT_NAME=yingyu
